{
  "name": "dispatch",
  "version": "1.0.0",
  "private": true,
  "description": "An editorial newsroom assistant built on Cloudflare Workers, Workers AI, Vectorize and D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:local": "wrangler d1 execute dispatch --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute dispatch --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
